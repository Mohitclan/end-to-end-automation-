# growthstack configuration. Copy to .env (never commit .env) and fill in.
# Empty integration settings = that integration is off and its job is skipped.

# --- core ---------------------------------------------------------------------
ENVIRONMENT=development                # production enables the safety checks below
SECRET_KEY=                            # REQUIRED in every environment, 32+ random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
BASE_URL=http://localhost:8000         # public https URL in production (used in unsubscribe links)
DATABASE_URL=sqlite:///./dev-data/growthstack.db   # production: postgresql+psycopg://user:pass@host/db
REDIS_URL=redis://localhost:6379/0     # BullMQ; Redis 6.2+ with maxmemory-policy noeviction
QUEUE_PREFIX=growthstack
SESSION_COOKIE_SECURE=false            # true behind HTTPS (required in production)
FORWARDED_ALLOW_IPS=127.0.0.1          # reverse proxy address trusted for client IPs; never *
LOG_LEVEL=INFO
DATA_DIR=./dev-data                    # writable dir for refreshed data files

# --- sender identity / compliance (appears in every outreach email) ----------
COMPANY_NAME=Our Company Ltd
COMPANY_POSTAL_ADDRESS=                # required in production
UNSUBSCRIBE_MAILTO=                    # optional extra mailto: for List-Unsubscribe

# --- Stage 4: Resend -----------------------------------------------------------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=                 # whsec_... from the Resend webhook page
EMAIL_DRY_RUN=true                     # true = nothing is sent; set false only when ready

# --- Stage 2: AI steps -----------------------------------------------------------
LLM_PROVIDER=fake                      # anthropic | ollama | fake (fake = dev placeholder drafts)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium                      # low | medium | high | xhigh | max
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LANGGRAPH_CHECKPOINT_PATH=./dev-data/langgraph-checkpoints.sqlite
ICP_DESCRIPTION=B2B software companies with 10-200 employees
ICP_TITLE_KEYWORDS=founder,ceo,cto,head,director,vp,owner
ICP_COUNTRIES=                         # e.g. united kingdom,ireland (empty = any)
ICP_SIC_PREFIXES=                      # e.g. 620,631 (empty = any)
PRODUCT_PITCH=We help small B2B teams find and win their first customers.
SENDER_FIRST_NAME=Alex
MIN_SCORE_TO_DRAFT=30                  # leads scoring below this are not drafted

# --- Stage 2: website research ----------------------------------------------------
CRAWL4AI_URL=                          # e.g. http://crawl4ai:11235 (self-hosted)
CRAWL4AI_TOKEN=
FIRECRAWL_API_KEY=                     # backup only
CRAWLER_USER_AGENT=growthstack-research/0.1 (+mailto:you@company.com)
RESEARCH_MAX_CHARS=12000

# --- Stage 6: Twenty CRM ---------------------------------------------------------
TWENTY_API_URL=                        # e.g. https://crm.company.com/rest
TWENTY_API_KEY=

# --- Stage 7: PostHog --------------------------------------------------------------
POSTHOG_PROJECT_API_KEY=               # phc_... (public, used by the site snippet)
POSTHOG_PERSONAL_API_KEY=              # personal key with Query Read scope
POSTHOG_PROJECT_ID=
POSTHOG_REGION=us                      # us | eu (our project is on US Cloud)
POSTHOG_SIGNUP_EVENT=user_signed_up

# --- Stage 5: Search Console + PageSpeed Insights ------------------------------------
GSC_SITE_URL=                          # sc-domain:company.com or https://company.com/
GSC_SERVICE_ACCOUNT_FILE=              # path to the service account JSON (add its email as a user in Search Console)
PSI_API_KEY=
PSI_URLS=                              # comma separated pages to score daily

# --- Stage 3: sending domain -----------------------------------------------------------
SENDING_DOMAIN=                        # checked daily with checkdmarc

# --- Stage 1: lead sources -------------------------------------------------------------
COMPANIES_HOUSE_API_KEY=
HUNTER_API_KEY=

# --- Phase 3: listmonk newsletters --------------------------------------------------------
LISTMONK_URL=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=

# --- reply detection ---------------------------------------------------------------------
REPLY_POLL_SECONDS=300
# IMAP passwords: one env var per mailbox, named in the mailbox's settings, e.g.
# IMAP_PASSWORD_SALES=
